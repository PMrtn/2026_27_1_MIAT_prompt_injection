# Normalise line endings: LF everywhere in the working tree, CRLF only for Windows shells.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artefacts
*.png binary
*.jpg binary
*.pdf binary
*.pptx binary
*.docx binary
*.pt binary
*.bin binary
*.safetensors binary
